{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  dependencyDashboard: true,
  schedule: ["* 1 * * 1"],
  timezone: "Etc/GMT",
  automerge: false,
  separateMajorMinor: true,
  separateMultipleMajor: true,
  separateMinorPatch: true,
  ignorePaths: [
    // Defaults from config:recommended (:ignoreModulesAndTests), since this option overrides them
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    // Grammars copied from upstream tree-sitter repositories
    "resources/language-metavariables/**",
  ],
  packageRules: [
    {
      groupName: "github-actions",
      matchManagers: ["github-actions"],
    },
    {
      groupName: "cargo",
      matchManagers: ["cargo"],
    },
  ],
}
