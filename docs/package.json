{
  "name": "@getgrit/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "stop": "kill -9 $(lsof -t -i:3200) || true",
    "dev": "next dev -p 3200 --webpack",
    "clean": "rm -rf ./node_modules && rm -rf .next",
    "build": "next build --webpack",
    "test": "pnpm run test:visual",
    "test:ci": "pnpm run test:visual --retries=3",
    "test:links": "blc http://127.0.0.1:3200/ -ro --exclude http://127.0.0.1:3200/discord --exclude http://localhost:3000/* --exclude https://marketplace.visualstudio.com/* --exclude https://www.grit.io/register --exclude https://www.grit.io/careers --exclude *.png",
    "test:visual": "playwright test --config=src/__checks__/playwright.config.ts",
    "start": "next start -p 3200 --webpack",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@markdoc/markdoc": "0.2.2",
    "@markdoc/next.js": "0.2.3",
    "@mdx-js/loader": "3.1.1",
    "@monaco-editor/react": "4.7.0",
    "@next/mdx": "16.3.3",
    "@tailwindcss/typography": "0.5.20",
    "body-scroll-lock": "4.0.0-beta.0",
    "classnames": "2.5.1",
    "clsx": "2.1.1",
    "critters": "0.0.25",
    "graphql": "16.14.2",
    "graphql-request": "7.4.0",
    "grit-wasm-bindings": "file:./../__generated__/grit-wasm-bindings",
    "lodash": "4.18.1",
    "monaco-editor": "0.56.0",
    "next": "16.3.8",
    "next-compose-plugins": "2.2.1",
    "nprogress": "0.2.0",
    "prism-react-renderer": "2.4.1",
    "quickjs-emscripten": "0.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "4.12.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "turbo": "2.10.12",
    "web-tree-sitter": "0.20.8",
    "web-tree-sitter-wasm-bindgen": "0.20.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/body-scroll-lock": "3.1.2",
    "@types/lodash": "4.17.25",
    "@types/node": "18.7.13",
    "@types/nprogress": "0.2.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "broken-link-checker": "0.7.8",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-markdownlint": "0.10.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "markdownlint": "0.41.1",
    "postcss": "8.5.26",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.0.0",
      "onFail": "download"
    }
  }
}
