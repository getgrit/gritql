---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage frontmatter={{ title: 'Feature Request', editUrl: false }}>
  <p>Use this form to request support for a new migration, language, or other feature.</p>
  <iframe
    data-tally-src="https://tally.so/embed/nP1lqV?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
    loading="lazy"
    width="100%"
    height="715"
    title="Grit - Feature Request"></iframe>

  <!-- Tally's embed snippet: loads the embed script, falling back to plain iframes. -->
  <script is:inline>
    var d=document,w="https://tally.so/widgets/embed.js",v=function(){"undefined"!=typeof Tally?Tally.loadEmbeds():d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach((function(e){e.src=e.dataset.tallySrc}))};if("undefined"!=typeof Tally)v();else if(d.querySelector('script[src="'+w+'"]')==null){var s=d.createElement("script");s.src=w,s.onload=v,s.onerror=v,d.body.appendChild(s);}
  </script>
</StarlightPage>
